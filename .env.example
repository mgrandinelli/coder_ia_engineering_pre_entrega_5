# Plantilla de variables de entorno: copiar como .env y completar la clave. El .env no se sube al repo.

# Proveedor del modelo de lenguaje: openai o anthropic
LLM_PROVIDER=openai

# Solo hace falta la clave del proveedor elegido. Sin clave, el agente corre en modo demostración.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales: modelo de cada proveedor (si se dejan vacíos se usan estos valores)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
